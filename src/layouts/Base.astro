---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '../styles/global.css';
import { getModuleTree } from '../utils/course';
import { getAllLabs } from '../utils/labs';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "WEAPON — Reverse Engineering Startup Course" } = Astro.props;

const tree = await getModuleTree();
const paletteModules = tree.map((m) => ({
  id: m.id,
  label: m.label,
  summary: m.summary,
  lessons: m.lessons.map((l) => ({ id: l.id, title: l.title, href: l.href, objectives: l.objectives })),
}));
const paletteLabs = getAllLabs().map((l) => ({ id: l.id, title: l.title, module: l.module, description: l.description }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | WEAPON</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1 w-full max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-8">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<script type="application/json" id="palette-modules-data" is:inline set:html={JSON.stringify(paletteModules)} />
<script type="application/json" id="palette-labs-data" is:inline set:html={JSON.stringify(paletteLabs)} />

<script>
  import { updateRankBadge } from '../scripts/progress';
  import { updateProgressUI, updateDashboardUI } from '../scripts/progress-ui';
  import { mountInteractives } from '../components/interactive/mount';
  import { initCommandPalette } from '../components/CommandPalette';

  updateRankBadge();
  mountInteractives();
  updateProgressUI();
  updateDashboardUI();
  window.addEventListener('weapon:progress', updateDashboardUI);

  // Register service worker for offline support
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').then((reg) => {
        console.log('Service Worker registered:', reg.scope);
      }).catch((err) => {
        console.warn('Service Worker registration failed:', err);
      });
    });
  }

  // Initialize command palette with the full module/lesson/lab index
  function tryInitPalette() {
    const modulesEl = document.getElementById('palette-modules-data');
    const labsEl = document.getElementById('palette-labs-data');
    try {
      const modules = JSON.parse(modulesEl?.textContent || '[]');
      const labs = JSON.parse(labsEl?.textContent || '[]');
      initCommandPalette(modules, labs);
    } catch (e) {
      console.warn('Failed to init command palette', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tryInitPalette);
  } else {
    tryInitPalette();
  }
</script>