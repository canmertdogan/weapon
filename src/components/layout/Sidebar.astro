---
import type { ModuleNode } from '../../utils/course';
import { BASE } from '../../utils/base';
interface Props {
  modules: ModuleNode[];
  currentModule?: string;
  currentLesson?: string;
}
const { modules, currentModule, currentLesson } = Astro.props;
---

<aside
  id="sidebar"
  class="fixed inset-y-0 left-0 z-50 w-72 bg-bg-elevated border-r border-border-strong transform -translate-x-full transition-transform duration-300 ease-out lg:relative lg:translate-x-0 lg:static"
  data-open="false"
  aria-label="Course navigation"
>
  <div class="flex flex-col h-full overflow-hidden lg:h-screen lg:sticky lg:top-16">
    <div class="p-4 border-b border-border flex items-center justify-between lg:hidden">
      <span class="font-display font-bold text-lg text-accent text-glow">WEAPON</span>
      <button class="btn btn-ghost p-1" id="sidebar-close" aria-label="Close navigation">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto p-4 space-y-6 scrollbar-thin" aria-label="Modules">
      {modules.map((module) => (
        <section class="space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-medium text-xs uppercase tracking-wider text-fg-muted">
              {module.label}
            </h3>
          </div>
          {module.lessons.length > 0 && (
            <ul class="space-y-1" role="list">
              {module.lessons.map((lesson) => {
                const isActive = currentModule === module.id && currentLesson === lesson.id;
                return (
                  <li>
                    <a
                      href={lesson.href}
                      data-lesson-id={lesson.id}
                      class:list={[
                        'flex items-center gap-2 px-3 py-2 rounded-md text-sm transition-colors',
                        isActive
                          ? 'bg-accent/10 text-accent border-l-2 border-l-accent'
                          : 'text-fg hover:bg-bg',
                      ]}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      <span class="flex-shrink-0 w-5 text-center font-mono text-xs text-fg-muted/50">
                        {String(lesson.order).padStart(2, '0')}
                      </span>
                      <span class="truncate">{lesson.title}</span>
                      <span class="completion-mark hidden text-accent flex-shrink-0" aria-hidden="true">✓</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          {module.lessons.length === 0 && (
            <p class="text-xs text-fg-muted/50 px-3 py-1">Coming soon</p>
          )}
        </section>
      ))}
    </nav>

    <div class="p-4 border-t border-border lg:hidden">
      <a href={`${BASE}labs`} class="btn btn-secondary w-full justify-center text-sm">Labs</a>
    </div>
  </div>
</aside>

<div
  id="sidebar-overlay"
  class="fixed inset-0 z-40 bg-black/50 hidden lg:hidden"
  aria-hidden="true"
></div>

<script>
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const closeBtn = document.getElementById('sidebar-close');

  let touchStartX = 0;
  let touchStartY = 0;
  let isDragging = false;

  function closeSidebar() {
    if (!sidebar) return;
    sidebar.dataset.open = 'false';
    sidebar.classList.add('-translate-x-full');
    sidebar.style.transform = '';
    if (overlay) overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function openSidebar() {
    if (!sidebar) return;
    sidebar.dataset.open = 'true';
    sidebar.classList.remove('-translate-x-full');
    sidebar.style.transform = '';
    if (overlay) overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  (window as any).toggleSidebar = () => {
    if (sidebar && sidebar.dataset.open === 'true') {
      closeSidebar();
    } else {
      openSidebar();
    }
  };
  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);

  // Touch swipe handling for mobile sidebar
  document.addEventListener('touchstart', (e) => {
    if (window.innerWidth >= 1024) return;
    const target = e.target as HTMLElement;
    // Only handle swipes from the edge (within 30px) or when sidebar is open
    const isFromEdge = e.touches[0].clientX < 30;
    const isSidebarOpen = sidebar?.dataset.open === 'true';
    if (isFromEdge || isSidebarOpen) {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      isDragging = true;
    }
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (!isDragging || window.innerWidth >= 1024 || !sidebar) return;
    const deltaX = e.touches[0].clientX - touchStartX;
    const deltaY = Math.abs(e.touches[0].clientY - touchStartY);

    // Ignore vertical scrolling
    if (deltaY > Math.abs(deltaX)) {
      isDragging = false;
      return;
    }

    e.preventDefault();
    const isOpen = sidebar.dataset.open === 'true';
    let translateX = 0;

    if (isOpen) {
      // Dragging left to close
      translateX = Math.min(0, deltaX);
    } else {
      // Dragging right to open
      translateX = Math.min(0, 300 + deltaX); // 300px = sidebar width approx
    }

    sidebar.style.transform = `translateX(${translateX}px)`;
    if (overlay) {
      overlay.style.opacity = String(Math.max(0, Math.min(1, (translateX + 300) / 300)));
      overlay.classList.remove('hidden');
    }
  }, { passive: false });

  document.addEventListener('touchend', () => {
    if (!isDragging || window.innerWidth >= 1024 || !sidebar) return;
    isDragging = false;

    const deltaX = touchStartX - (touchStartX + (touchStartX - touchStartX)); // Reset calculation
    const isOpen = sidebar.dataset.open === 'true';
    const threshold = 100; // px to trigger open/close

    sidebar.style.transition = 'transform 0.2s ease-out';
    if (overlay) overlay.style.transition = 'opacity 0.2s ease-out';

    if (isOpen) {
      if (Math.abs(deltaX) > threshold) {
        closeSidebar();
      } else {
        sidebar.style.transform = 'translateX(0)';
        if (overlay) overlay.style.opacity = '1';
      }
    } else {
      if (deltaX < -threshold) { // Swiped right enough
        openSidebar();
      } else {
        sidebar.style.transform = 'translateX(-100%)';
        if (overlay) overlay.classList.add('hidden');
      }
    }

    setTimeout(() => {
      if (sidebar) sidebar.style.transition = '';
      if (overlay) overlay.style.transition = '';
    }, 200);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar && sidebar.dataset.open === 'true') {
      closeSidebar();
    }
  });
</script>

<style>
  @media (min-width: 1024px) {
    #sidebar { transform: translateX(0); }
  }
</style>
