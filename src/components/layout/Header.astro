---
import { BASE } from '../../utils/base';

const path = Astro.url.pathname;

interface NavLink {
  href: string;
  label: string;
  match?: string;
  exact?: boolean;
}
const links: NavLink[] = [
  { href: BASE, label: 'Dashboard', exact: true },
  { href: `${BASE}labs`, label: 'Labs', match: 'labs' },
  { href: `${BASE}cheatsheets`, label: 'Cheatsheets', match: 'cheatsheets' },
  { href: `${BASE}tools`, label: 'Tools', match: 'tools' },
  { href: `${BASE}about`, label: 'About', match: 'about' },
];
const isActive = (link: NavLink) =>
  link.exact ? path === link.href : path.includes(`${BASE}${link.match}`);
---

<header id="site-header" class="border-b border-border-strong bg-bg-elevated/85 backdrop-blur-sm sticky top-0 z-40">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <button
        id="mobile-menu-btn"
        class="btn btn-ghost md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <a href={BASE} class="font-display font-bold text-xl tracking-[0.15em] text-accent select-none">
        WEAPON
      </a>
      <nav class="hidden md:flex items-center gap-1 ml-2" aria-label="Primary">
        {links.map((link) => (
          <a href={link.href} class:list={['nav-pill', isActive(link) && 'is-active']} aria-current={isActive(link) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-3 relative">
      <div id="header-progress" class="flex items-center gap-3" hidden>
        <div class="progress-ring progress-ring--sm" data-overall-progress title="Overall course progress">
          <svg viewBox="0 0 100 100">
            <circle class="progress-ring-track" cx="50" cy="50" r="42"></circle>
            <circle class="progress-ring-fill" cx="50" cy="50" r="42"></circle>
          </svg>
          <span class="progress-ring-label">0%</span>
        </div>
        <div class="rank-badge text-sm hidden sm:block" id="rank-badge">RECRUIT</div>
      </div>

      <div class="flex items-center gap-1">
        <a
          href="https://github.com/canmertdogan/weapon/issues/new"
          target="_blank"
          rel="noopener"
          aria-label="Report an issue"
          title="Report an issue"
          class="btn btn-ghost p-2"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="13"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </a>
        <a
          href="https://github.com/canmertdogan/weapon"
          target="_blank"
          rel="noopener"
          aria-label="View source on GitHub"
          title="View source on GitHub"
          class="btn btn-ghost p-2"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>

      <div id="mobile-nav" class="nav-dropdown md:hidden" hidden>
        {links.map((link) => (
          <a href={link.href} class:list={['nav-pill', isActive(link) && 'is-active']}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');

  function closeMobileNav() {
    if (mobileNav) mobileNav.hidden = true;
    btn?.setAttribute('aria-expanded', 'false');
  }

  btn?.addEventListener('click', () => {
    const hasSidebar = document.getElementById('sidebar');
    const toggleSidebar = (window as any).toggleSidebar;
    if (hasSidebar && typeof toggleSidebar === 'function') {
      toggleSidebar();
      return;
    }
    if (mobileNav) {
      const willOpen = mobileNav.hidden;
      mobileNav.hidden = !willOpen;
      btn?.setAttribute('aria-expanded', String(willOpen));
    }
  });

  document.addEventListener('click', (e) => {
    if (!mobileNav || mobileNav.hidden) return;
    const target = e.target as Node;
    if (!mobileNav.contains(target) && !btn?.contains(target)) {
      closeMobileNav();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileNav();
  });
</script>
