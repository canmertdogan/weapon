---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getModuleTree, getModuleProgressSummary } from '../utils/course';
import { getAllLabs } from '../utils/labs';
import { BASE } from '../utils/base';

const tree = await getModuleTree();
const { total: totalLessons } = await getModuleProgressSummary();
const totalLabs = getAllLabs().length;
const flatLessons = tree.flatMap((m) => m.lessons.map((l) => ({ id: l.id, title: l.title, href: l.href })));
const firstLesson = flatLessons[0];
---

<Base title="Dashboard" description="WEAPON — Reverse Engineering Startup Course">
  <Header slot="header" />

  <header class="py-10">
    <p class="font-mono text-xs text-accent tracking-[0.35em] uppercase mb-3">Field Manual</p>
    <h1 class="text-3xl md:text-4xl mb-3">WEAPON</h1>
    <p class="text-fg-muted max-w-2xl">
      A reverse engineering startup course — binary analysis, assembly, debugging, and Windows internals, taught through interactive investigation. Progress is saved locally in your browser; modules are open in any order.
    </p>
  </header>

  <section class="pb-6" aria-label="Recommended companion course">
    <a href="https://canmertdogan.github.io/storage/helper/mxdr-l1-soc-crash-course/index.html" target="_blank" rel="noreferrer" class="card card-hover flex flex-col sm:flex-row items-start sm:items-center gap-4 no-underline">
      <div class="flex-1">
        <p class="font-mono text-xs text-accent mb-1">NEW TO CYBERSECURITY?</p>
        <h3 class="text-lg mb-1">SOC Analyst's Handbook</h3>
        <p class="text-sm text-fg-muted">Try this core course module first — an interactive L1 SOC/MXDR training platform with 33 modules and a live incident-triage simulator.</p>
      </div>
      <span class="btn btn-secondary flex-shrink-0">Open Handbook <span aria-hidden="true">↗</span></span>
    </a>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-[minmax(0,220px)_1fr] gap-4 mb-4">
    <div class="card flex flex-col items-center justify-center gap-2 text-center py-8">
      <div class="progress-ring" style="--ring-size:120px" data-overall-progress>
        <svg viewBox="0 0 100 100">
          <circle class="progress-ring-track" cx="50" cy="50" r="42"></circle>
          <circle class="progress-ring-fill" cx="50" cy="50" r="42"></circle>
        </svg>
        <span class="progress-ring-label" style="font-size:1.35rem">0%</span>
      </div>
      <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mt-1">Overall Progress</p>
    </div>

    <div class="card flex flex-col justify-center gap-4">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-1">Rank</p>
          <p class="rank-badge text-2xl" id="rank-badge">RECRUIT</p>
        </div>
        <div class="flex gap-8">
          <div class="text-center">
            <p class="stat-tile-value text-xl" id="stat-lessons">0<span class="text-fg-muted text-base font-normal">/{totalLessons}</span></p>
            <p class="stat-tile-label">Lessons</p>
          </div>
          <div class="text-center">
            <p class="stat-tile-value text-xl" id="stat-labs">0<span class="text-fg-muted text-base font-normal">/{totalLabs}</span></p>
            <p class="stat-tile-label">Labs</p>
          </div>
          <div class="text-center">
            <p class="stat-tile-value text-xl">{tree.length}</p>
            <p class="stat-tile-label">Modules</p>
          </div>
        </div>
      </div>
      <div data-rank-progress>
        <div class="h-1.5 bg-border rounded-full overflow-hidden">
          <div class="progress-fill h-full bg-accent transition-all duration-500" data-rank-progress-fill style="width: 0%"></div>
        </div>
        <p class="text-xs text-fg-muted font-mono mt-2" data-rank-progress-label>&nbsp;</p>
      </div>
    </div>
  </section>

  {firstLesson && (
    <a id="continue-card" href={firstLesson.href} class="card card-hover flex items-center justify-between gap-4 mb-10">
      <div class="min-w-0">
        <p class="font-mono text-xs text-accent mb-1" id="continue-label">Start Here</p>
        <p class="text-lg font-display truncate" id="continue-title">{firstLesson.title}</p>
      </div>
      <span class="btn btn-primary flex-shrink-0">Continue →</span>
    </a>
  )}

  <section class="pb-16" aria-labelledby="modules-heading">
    <div class="flex items-center justify-between gap-3 mb-8">
      <h2 id="modules-heading" class="text-2xl">Module Roadmap</h2>
      <a href={`${BASE}labs`} class="btn btn-secondary flex-shrink-0">View Labs</a>
    </div>
    <div class="roadmap">
      {tree.map((module, i) => {
        const lessonIds = module.lessons.map((l) => l.id).join(',');
        return (
          <div class="roadmap-node" data-roadmap-node={module.id} data-lessons={lessonIds}>
            <div class="roadmap-marker">{String(i + 1).padStart(2, '0')}</div>
            <div class="roadmap-content card">
              <div class="flex items-center justify-between gap-3 mb-2">
                <a href={`${BASE}course/${module.id}`} class="font-display font-bold text-lg text-fg hover:text-accent-bright transition-colors">
                  {module.label}
                </a>
                <span class="flex items-center gap-2 flex-shrink-0">
                  <span class="badge badge-current">{module.lessons.length || '—'} lesson{module.lessons.length !== 1 ? 's' : ''}</span>
                </span>
              </div>
              <p class="text-sm text-fg-muted mb-3">{module.summary}</p>

              {module.lessons.length > 0 && (
                <div class="flex items-center gap-2 mb-4" data-module-progress data-lessons={lessonIds}>
                  <div class="flex-1 h-1.5 bg-border rounded-full overflow-hidden">
                    <div class="progress-fill h-full bg-accent transition-all duration-500" style="width: 0%"></div>
                  </div>
                  <span class="progress-label text-xs text-fg-muted font-mono">0%</span>
                </div>
              )}

              {module.lessons.length > 0 ? (
                <details class="accordion" data-accordion-module={module.id}>
                  <summary>
                    <span>Lessons</span>
                    <span class="accordion-caret" aria-hidden="true"></span>
                  </summary>
                  <div class="accordion-body">
                    <ol class="space-y-1">
                      {module.lessons.map((lesson) => (
                        <li>
                          <a
                            href={lesson.href}
                            data-lesson-id={lesson.id}
                            class="flex items-center gap-3 px-2 py-2 rounded-md hover:bg-bg transition-colors text-sm"
                          >
                            <span class="font-mono text-xs text-fg-muted/50 w-6 flex-shrink-0">{String(lesson.order).padStart(2, '0')}</span>
                            <span class="flex-1 text-fg">{lesson.title}</span>
                            <span class="completion-mark hidden text-accent flex-shrink-0" aria-hidden="true">✓</span>
                            <span class="font-mono text-xs text-fg-muted/50">{lesson.duration}m</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </div>
                </details>
              ) : (
                <p class="text-sm text-fg-muted/50 italic">Content coming in a future release.</p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="pb-16" aria-labelledby="settings-heading">
    <h2 id="settings-heading" class="text-2xl mb-8">Settings</h2>
    <div class="card space-y-6">
      <div>
        <h3 class="text-lg mb-4">Progress Backup</h3>
        <div class="flex flex-wrap gap-3">
          <button id="export-progress" class="btn btn-secondary">Export Progress (JSON)</button>
          <button id="import-progress" class="btn btn-secondary">Import Progress</button>
          <input type="file" id="import-file" accept=".json" class="hidden" />
        </div>
        <p class="text-sm text-fg-muted mt-2">Backup your progress to a file or restore from a previous export.</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<script type="application/json" id="lessons-data" is:inline set:html={JSON.stringify(flatLessons)} />

<script>
  import { loadProgress, exportProgressData, importProgressData } from '../scripts/progress';

  const lessonsEl = document.getElementById('lessons-data');
  const card = document.getElementById('continue-card');
  const label = document.getElementById('continue-label');
  const title = document.getElementById('continue-title');
  const statLessons = document.getElementById('stat-lessons');
  const statLabs = document.getElementById('stat-labs');

  try {
    const progress = loadProgress();

    if (statLessons) {
      const suffix = statLessons.querySelector('span');
      statLessons.textContent = String(progress.completedLessons.length);
      if (suffix) statLessons.appendChild(suffix);
    }
    if (statLabs) {
      const suffix = statLabs.querySelector('span');
      statLabs.textContent = String(progress.completedLabs.length);
      if (suffix) statLabs.appendChild(suffix);
    }

    if (lessonsEl && card) {
      const lessons = JSON.parse(lessonsEl.textContent || '[]');
      const hasStarted = progress.completedLessons.length > 0 || progress.currentLesson !== 's1';
      const current = lessons.find((l: { id: string }) => l.id === progress.currentLesson) || lessons[0];
      if (current) {
        card.setAttribute('href', current.href);
        if (label) label.textContent = hasStarted ? 'Continue' : 'Start Here';
        if (title) title.textContent = current.title;
      }
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-accordion-module]').forEach((acc) => {
      if (acc.querySelector(`[data-lesson-id="${progress.currentLesson}"]`)) {
        acc.setAttribute('open', '');
      }
    });

    // Settings: Progress export/import
    const exportBtn = document.getElementById('export-progress');
    const importBtn = document.getElementById('import-progress');
    const importFile = document.getElementById('import-file') as HTMLInputElement;

    exportBtn?.addEventListener('click', () => {
      const json = exportProgressData();
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `weapon-progress-${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    importBtn?.addEventListener('click', () => importFile?.click());
    importFile?.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const text = await file.text();
      const result = importProgressData(text);
      if (result) {
        alert('Progress imported successfully! Reloading...');
        window.location.reload();
      } else {
        alert('Failed to import progress. Invalid file format.');
      }
      importFile.value = '';
    });
  } catch (e) {
    console.warn('Failed to hydrate dashboard', e);
  }
</script>
